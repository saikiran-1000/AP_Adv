  # Function to parse stored invoice text
def parse_invoice_text(text):
    parts = text.split(" ### ")
    invoice_no = parts[0].split(": ")[1].strip()
    vendor = parts[1].split(": ")[1].strip()
    amount = float(parts[2].split(": ")[1].strip())
    date = parts[3].split(": ")[1].strip()
    return {"invoice_no": invoice_no, "vendor": vendor, "amount": amount, "date": date}

# Function to calculate field-by-field similarity
def calculate_field_similarity(new_inv, stored_inv):
    # Different weights for different fields
    invoice_weight = 0.25  # Highest weight for invoice number 0.45
    amount_weight = 0.25   # High weight for amount 0.35
    date_weight = 0.25     # Medium weight for date 0.15
    vendor_weight = 0.25   # Lower weight for vendor (since vendors issue many invoices) 0.05
    
    # Calculate individual field scores
    invoice_match = 1.0 if new_inv["invoice_no"] == stored_inv["invoice_no"] else 0.0
    
    # Vendor match (simple for this example)
    vendor_match = 1.0 if new_inv["vendor"] == stored_inv["vendor"] else 0.0
    
    # Amount similarity (with tolerance for small differences)
    amount_diff_pct = abs(new_inv["amount"] - stored_inv["amount"]) / max(new_inv["amount"], stored_inv["amount"])
    amount_match = max(0, 1.0 - amount_diff_pct * 2)  # More sensitive to amount differences
    
    # Date similarity (consider closeness of dates)
    from datetime import datetime
    try:
        new_date = datetime.strptime(new_inv["date"], "%Y-%m-%d")
        stored_date = datetime.strptime(stored_inv["date"], "%Y-%m-%d")
        days_diff = abs((new_date - stored_date).days)
        date_match = max(0, 1.0 - (days_diff / 90))  # Scale by 3 months (more sensitive)
    except ValueError:
        date_match = 0.0  # If date parsing fails
        days_diff = None
        
    # Weighted combination
    field_similarity = (
        invoice_weight * invoice_match +
        amount_weight * amount_match +
        date_weight * date_match +
        vendor_weight * vendor_match
    )
    
    return {
        "overall": field_similarity,
        "invoice_match": invoice_match,
        "vendor_match": vendor_match,
        "amount_match": amount_match,
        "date_match": date_match,
        "amount_diff_pct": amount_diff_pct * 100,
        "days_diff": days_diff
    }

# Function to adjust semantic similarity based on field differences
def adjust_semantic_similarity(semantic_sim, field_sim_data):
    # Start with the original semantic similarity
    adjusted_sim = semantic_sim
    
    # Apply penalties for key differences
    if field_sim_data["invoice_match"] < 0.9:  # Different invoice numbers
        adjusted_sim *= 0.85
    
    # Large amount differences should reduce similarity
    amount_diff_pct = field_sim_data["amount_diff_pct"]
    if amount_diff_pct > 20:
        adjusted_sim *= max(0.5, 1.0 - (amount_diff_pct / 200))
    
    # Date differences should reduce similarity
    days_diff = field_sim_data["days_diff"]
    if days_diff is not None and days_diff > 30:
        adjusted_sim *= max(0.5, 1.0 - (days_diff / 400))
    
    # Different vendors should reduce similarity
    if field_sim_data["vendor_match"] < 0.9:
        adjusted_sim *= 0.9
    
    return adjusted_sim

