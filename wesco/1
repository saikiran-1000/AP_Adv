def match_invoice_lines_rag(df, retriever):
    invoice_df = df[["Id", "invoice_desc", "CoraAP__Product_Service_No__c", "WO_Vendor_Part_Number__c"]].drop_duplicates()
    matched_po_ids = set()
    results = []
    
    load_dotenv()
    api_key = os.environ["AZURE_LLM_OPENAI_API_KEY"]
    azure_endpoint = os.environ['AZURE_LLM_OPENAI_ENDPOINT']
    api_version = os.environ['AZURE_LLM_OPENAI_API_VERSION']
    deployment_name=os.environ["LLM_DEPLOYMENT_NAME"]

    llm = AzureChatOpenAI(
        api_key=api_key,
        azure_endpoint=azure_endpoint,
        model_name = "gpt35turbo",
        deployment_name = deployment_name,
        api_version=api_version
    )
    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        retriever=retriever,
        chain_type="stuff",
        chain_type_kwargs={"prompt": prompt_template}
    )

    for _, row in invoice_df.iterrows():
        question = f"Invoice Line ID: {row['Id']}\nDescription: {row['invoice_desc']}\nProduct/Service No: {row['CoraAP__Product_Service_No__c']}\nVendor Part No: {row['WO_Vendor_Part_Number__c']}"
        answer = qa_chain.run(question)

        po_id = None
        match_pct = 0
        rule = "No Match"

        # Parse LLM response
        for line in answer.splitlines():
            if "PO Line ID" in line:
                po_id = line.split(":")[-1].strip()
            if "matchPercentage" in line.lower():
                match_pct = float(line.split(":")[-1].strip().replace("%", ""))
            if "Rule" in line:
                rule = line.split(":")[-1].strip()

        if po_id and po_id not in matched_po_ids:
            matched_po_ids.add(po_id)
            results.append({
                "Invoice_Line_Id": row["Id"],
                "PO_Line_Id": po_id,
                "MatchPercentage": match_pct,
                "Rule": rule
            })
        else:
            results.append({
                "Invoice_Line_Id": row["Id"],
                "PO_Line_Id": None,
                "MatchPercentage": 0,
                "Rule": "No Match"
            })

    return pd.DataFrame(results)
