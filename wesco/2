    df["inv_color"] = df["invoice_desc"].apply(extract_color)

    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        retriever=retriever,
        chain_type="stuff",
        chain_type_kwargs={"prompt": prompt_template}
    )

    used_po_ids = set()
    matches = []

    for _, row in df.iterrows():
        invoice_line = row["invoice_desc"]
        invoice_id = row["Id"]
