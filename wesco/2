        inv_code = row["CoraAP__Product_Service_No__c"]
        inv_part = row["WO_Vendor_Part_Number__c"]

        question = f"""
Match this invoice line:
Invoice ID: {invoice_id}
Product No: {inv_code}
Vendor Part No: {inv_part}
Description: {invoice_line}
Color: {inv_color}
Return the best matching PO Line ID and the reason for match.
"""

        response = qa_chain.run(question)

        # Post-process response (you can improve this based on exact output style)
        match_id = None
        reason = "No Match"
        if "PO Line ID" in response:
            match = re.search(r"PO Line ID:\s*([^\n]+)", response)
            if match:
                match_id = match.group(1).strip()
