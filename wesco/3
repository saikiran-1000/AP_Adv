def preprocess(df):
    df["invoice_desc"] = df["CoraAP__Product_Service_Description__c"].fillna("").astype(str)
    df["po_desc"] = df["CoraAP__PO_Line_Item__r.CoraAP__Product_Service_Description__c"].fillna("").astype(str)
    df["inv_color"] = df["invoice_desc"].apply(extract_color)
    df["po_color"] = df["po_desc"].apply(extract_color)
    return df

def compute_embeddings(texts):
    return np.array(embeddings.embed_documents(texts))  # Convert list of embeddings to numpy array

def build_faiss_index(embeddings_array):
    dim = embeddings_array.shape[1]
    index = faiss.IndexFlatL2(dim)
    index.add(embeddings_array)
    return index

def match_lines(df):
    invoice_lines = df[["Id", "CoraAP__Product_Service_No__c", "WO_Vendor_Part_Number__c", "invoice_desc", "inv_color"]].drop_duplicates()
    po_lines = df[["CoraAP__PO_Line_Item__c", "CoraAP__PO_Line_Item__r.CoraAP__Product_Service_No__c", "CoraAP__PO_Line_Item__r.WO_VendorPartNumber__c", "po_desc", "po_color"]].drop_duplicates()

    invoice_embeddings = compute_embeddings(invoice_lines["invoice_desc"].tolist())
    po_embeddings = compute_embeddings(po_lines["po_desc"].tolist())

    po_index = build_faiss_index(po_embeddings)
    distances, indices = po_index.search(invoice_embeddings, k=3)

    used_po_ids = set()
    results = []

    for i, inv_row in invoice_lines.iterrows():
        best_match = None
        best_score = 0
        inv_id = inv_row["Id"]
        inv_code = str(inv_row["CoraAP__Product_Service_No__c"])
        inv_part = str(inv_row["WO_Vendor_Part_Number__c"])
        inv_color = inv_row["inv_color"]

        for rank, j in enumerate(indices[i]):
            po_row = po_lines.iloc[j]
            po_id = po_row["CoraAP__PO_Line_Item__c"]
            po_code = str(po_row["CoraAP__PO_Line_Item__r.CoraAP__Product_Service_No__c"])
            po_part = str(po_row["CoraAP__PO_Line_Item__r.WO_VendorPartNumber__c"])
            po_color = po_row["po_color"]

            if po_id in used_po_ids:
                continue

            # Rule 1: Exact match
            if inv_code and po_code and inv_code == po_code:
                best_match = (inv_id, po_id, 100, "Exact_Product_Code")
                break
            if inv_part and po_part and inv_part == po_part:
                best_match = (inv_id, po_id, 100, "Exact_Vendor_Part")
                break

            # Rule 3: Color check (strict)
            if inv_color or po_color:
                if inv_color != po_color:
                    continue  # Color mismatch – invalid match

            # Rule 2: Semantic match
            score = cosine_similarity([invoice_embeddings[i]], [po_embeddings[j]])[0][0]
            match_pct = round(score * 100, 2)

            if match_pct >= 90:
                match_type = "Strong_Semantic"
            elif 40 <= match_pct < 90:
                match_type = "Moderate_Semantic"
            else:
                continue

            if match_pct > best_score:
                best_match = (inv_id, po_id, match_pct, match_type)
                best_score = match_pct

        if best_match:
            inv_id, po_id, match_pct, rule = best_match
            used_po_ids.add(po_id)
            results.append({
                "Invoice_Line_Id": inv_id,
                "PO_Line_Id": po_id,
                "MatchPercentage": match_pct,
                "Rule": rule
            })
        else:
            results.append({
                "Invoice_Line_Id": inv_id,
                "PO_Line_Id": None,
                "MatchPercentage": 0,
                "Rule": "No Match"
            })

    return pd.DataFrame(results)
