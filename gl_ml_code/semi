def data_loader(folder_path, x_field, y_field):
    print("DATA LOADING...\n")
    files = os.listdir(folder_path)
    if not files:
        raise ValueError(f"No folder name {folder_path} found.")

    field_to_continue = []
    if len(x_field) > 0 or len(y_field) > 0:
        if len(x_field) > 0:
            field_to_continue.extend(x_field)
        else:
            raise ValueError("Please provide input fields (x_field).")
        if len(y_field) > 0:
            field_to_continue.extend(y_field)
        else:
            raise ValueError("Please provide label fields (y_field).")
    if len(field_to_continue) == 0:
        raise ValueError("Field list is empty. Please provide fields to train.")

    for file in files:
        file_path = os.path.join(folder_path, file)
        ext = os.path.splitext(file)[-1].lower()

        try:
            if ext == '.csv':
                df = pd.read_csv(file_path,encoding='latin1')
                df = df[field_to_continue]
                return df, True
            elif ext in ['.xlsx', '.xls']:
                df = pd.read_excel(file_path)
                df = df[field_to_continue]
                return df, True
            elif ext == '.xlsb':
                import pyxlsb  
                df = pd.read_excel(file_path, engine='pyxlsb')
                df = df[field_to_continue]
                return df, True
        except Exception as e:
            raise ValueError(f"Error loading {file}: {e}. Please provide a supported file type: .csv, .xlsx, .xls, or .xlsb")

    # No readable files found
    raise ValueError("No supported files found in the folder.")

