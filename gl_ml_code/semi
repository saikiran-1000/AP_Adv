def prepare_scope2_data(df, best_combo, low, high, target_col="gl__cc"):
    print("PREPARING DATA FOR TRAINING...\n")
    if df is None or df.empty:
        raise ValueError("Input DataFrame is empty or None.")
    
    if not isinstance(best_combo, (list, tuple)) or len(best_combo) == 0:
        raise ValueError("best_combo must be a non-empty list or tuple of column names.")
    
    if target_col not in df.columns:
        raise ValueError(f"Target column '{target_col}' not found in the dataframe.")
    
    for col in best_combo:
        if col not in df.columns:
            raise ValueError(f"Column '{col}' in best_combo not found in the dataframe.")
    
    if not isinstance(low, int) or not isinstance(high, int) or low < 1 or high < 1 or low > high:
        raise ValueError("Invalid range provided: 'low' and 'high' must be positive integers and low <= high.")

    df["merged"] = df[list(best_combo)].astype(str).agg("_".join, axis=1)

    grouped = df.groupby("merged")[target_col].nunique().reset_index(name="unique_count")
    merged_eq1 = grouped[grouped["unique_count"] == 1]["merged"]
    merged_inrange = grouped[
        (grouped["unique_count"] >= low) & (grouped["unique_count"] <= high)
    ]["merged"]

    df_eq1 = df[df["merged"].isin(merged_eq1)].copy()
    df_inrange = df[df["merged"].isin(merged_inrange)].copy()

    df_eq1.drop(columns=list(best_combo), inplace=True, errors='ignore')
    df_inrange.drop(columns=list(best_combo), inplace=True, errors='ignore')

    return df_eq1, df_inrange

