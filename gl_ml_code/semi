def load_and_clean_data(data, train):
    print("CLEANING THE DATA...\n")
    global x_field
    if data is None or not train:
        raise ValueError("No data to process. Please ensure data is loaded and 'train' is set to True.")

    data = data.copy()

    ##################################################################################
    print("Before - ", data.shape)
    old_num = data.shape[0]

    data = data.dropna()

    print("After - ", data.shape)
    new_num = data.shape[0]

    # if more than 10% data is dropped raise an error
    if new_num < 0.9 * old_num:
        raise ValueError("More than 10% of the data was dropped due to missing values. Halting process.")
    ##################################################################################
    ##################################################
    # ----------- Should be only one label encoder --------------
    ##################################################
    label_encoders = {}
    for col in data.columns:
        if data[col].dtype == 'object':
            obj_field.append(col)
            data[col] = data[col].astype(str)
            le = LabelEncoder()
            data[col] = le.fit_transform(data[col]).astype('float32')
            label_encoders[col] = le
        elif np.issubdtype(data[col].dtype, np.number):
            data[col] = data[col].astype('float32')

    data['gl__cc'] = data[y_field[0]].astype(str)
    for i in range(1, len(y_field)):
        data['gl__cc'] = data['gl__cc'].astype(str) + "__" + data[y_field[i]].astype(str)
    data.drop(columns=y_field, inplace=True)

    # Remove highly correlated columns (corr > 0.85)
    corr_matrix = data[x_field].corr().abs()
    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))

    to_drop = []
    for col in upper.columns:
        for row in upper.index:
            if upper.loc[row, col] > 0.85:
                # Drop the one with fewer unique values
                if data[col].nunique() < data[row].nunique():
                    to_drop.append(col)
                else:
                    to_drop.append(row)
    to_drop = list(set(to_drop))
    print("DROPPING THESE COLUMNS: ",to_drop)
    for col in to_drop:
        if col in obj_field:
            obj_field.remove(col)
    data.drop(columns=to_drop, inplace=True)

    # Update x_field list after dropping
    x_field = [col for col in x_field if col not in to_drop]
    
    return data
