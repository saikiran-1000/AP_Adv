import pandas as pd

def select_features(df: pd.DataFrame, y_label: str, scoring='accuracy', cv=3):
    X = df.drop(columns=[y_label])
    y = df[y_label].astype(str) 

    # Identify feature types
    cat_cols = X.select_dtypes(include='object').columns
    num_cols = X.select_dtypes(include='number').columns

    # Fill missing values
    X[cat_cols] = X[cat_cols].fillna('missing')
    X[num_cols] = X[num_cols].fillna(X[num_cols].median())

    # Encode categorical features
    for col in cat_cols:
        le = LabelEncoder()
        X[col] = le.fit_transform(X[col])

    # Encode target
    y = LabelEncoder().fit_transform(y)

    # Model and SFS
    rf = RandomForestClassifier(n_estimators=100, random_state=42)
    sfs = SequentialFeatureSelector(rf, direction='forward', scoring=scoring, n_jobs=-1, cv=cv)
    sfs.fit(X, y)

    selected_features = X.columns[sfs.get_support()].tolist()

    return selected_features

def generate_pair_checks(columns):
    n = len(columns)
    if n <= 4:
        return list(range(n, 1, -1))
    else:
        return list(range(n-1, n//2, -1))

def find_best_column_combinations(df, columns, target_col="gl__cc", verbose=True, threshold=0.95):
    print("FINDING BEST COMBINATION...\n")
    if len(columns)==0:
        return ()
    
    # if len(obj_field)==len(x_field):
    #     return columns
    
    if target_col not in df.columns:
        raise ValueError(f"Target column '{target_col}' not found in the dataframe.")

    columns = [col for col in columns if col != target_col]
    if len(columns) < 2:
        return list(columns)
        # raise ValueError("At least two candidate columns are required for combination analysis.")

    pair_checks = generate_pair_checks(columns)
    if verbose:
        print("Pair checks:", pair_checks)

    best_combinations = {}
    cc = 0
    max_rows_covered = -1

    for k in pair_checks:
        pairs = list(combinations(columns, k))
        max_unique_1 = -1
        best_pair = ()
        row_covered = 0

        for pair in pairs:
            merged = df[list(pair)].astype(str).agg("__".join, axis=1)
            df["merged"] = merged

            grouped = df.groupby("merged")[target_col].nunique().reset_index()
            count_unique_1 = (grouped[target_col] == 1).sum()

            valid_merged_values = grouped.loc[grouped[target_col] == 1, "merged"]
            covered_rows = df[df["merged"].isin(valid_merged_values)].shape[0]

            if count_unique_1 > max_unique_1:
                max_unique_1 = count_unique_1
                best_pair = pair
                row_covered = covered_rows

            cc += 1
            # if verbose and cc % 30 == 0:
            #     print(f"Checked {cc} combinations...")

        best_combinations[k] = {
            "columns": best_pair,
            "count_unique_1": max_unique_1,
            "rows_covered": row_covered
        }

        if row_covered > max_rows_covered:
            max_rows_covered = row_covered

        if verbose:
            print(f"For {k} columns: Max 1-unique groups = {max_unique_1}, Rows covered = {row_covered}, Best Pair = {best_pair}")

    df.drop(columns=["merged"], inplace=True, errors='ignore')

    for k in sorted(best_combinations.keys()):
        combo = best_combinations[k]
        if combo["rows_covered"] >= threshold * max_rows_covered:
            if verbose:
                print(f"Selected {k}-column combination: {combo['columns']} with rows covered = {combo['rows_covered']}")
            return combo["columns"]

    # Fallback: return the best overall
    best_k = max(best_combinations, key=lambda x: best_combinations[x]["rows_covered"])
    if verbose:
        print(f"Fallback to best overall: {best_combinations[best_k]['columns']}")
    return best_combinations[best_k]["columns"]

